# SECTION 4: NAIVE BAYES CLASSIFIER
# ============================================================

class NaiveBayesClassifier:
    """Multinomial Naive Bayes classifier."""
    
    def __init__(self, alpha=1.0):
        self.alpha = alpha  # Laplace smoothing
        self.class_priors = {}
        self.feature_probs = {}
        self.classes = []
    
    def fit(self, X, y):
        """Train the classifier."""
        n_samples, n_features = X.shape
        self.classes = np.unique(y)
        
        for c in self.classes:
            # Get samples belonging to this class
            X_c = X[y == c]
            
            # Class prior probability
            self.class_priors[c] = len(X_c) / n_samples
            
            # Feature probabilities with Laplace smoothing
            feature_counts = X_c.sum(axis=0) + self.alpha
            total_count = feature_counts.sum()
            self.feature_probs[c] = feature_counts / total_count
        
        return self
    
    def predict(self, X):
        """Predict class labels."""
        predictions = []
        
        for sample in X:
            class_scores = {}
            for c in self.classes:
                # Log probability to avoid underflow
                log_prior = np.log(self.class_priors[c])
                
                # Sum of log probabilities for features
                log_likelihood = np.sum(sample * np.log(self.feature_probs[c] + 1e-10))
                
                class_scores[c] = log_prior + log_likelihood
            
            # Predict class with highest score
            predictions.append(max(class_scores, key=class_scores.get))
        
        return np.array(predictions)
    
    def predict_proba(self, X):
        """Predict class probabilities."""
        probabilities = []
        
        for sample in X:
            class_scores = {}
            for c in self.classes:
                log_prior = np.log(self.class_priors[c])
                log_likelihood = np.sum(sample * np.log(self.feature_probs[c] + 1e-10))
                class_scores[c] = log_prior + log_likelihood
            
            # Convert log probabilities to probabilities
            max_score = max(class_scores.values())
            exp_scores = {c: np.exp(s - max_score) for c, s in class_scores.items()}
            total = sum(exp_scores.values())
            probs = {c: s / total for c, s in exp_scores.items()}
            probabilities.append(probs)
        
        return probabilities


# ============================================================
# SECTION 5: SVM CLASSIFIER
# ============================================================

class SVMClassifier:
    """Support Vector Machine using gradient descent."""
    
    def __init__(self, learning_rate=0.001, lambda_param=0.01, n_iterations=1000):
        self.lr = learning_rate
        self.lambda_param = lambda_param
        self.n_iterations = n_iterations
        self.weights = None
        self.bias = None
    
    def fit(self, X, y):
        """Train the SVM classifier."""
        n_samples, n_features = X.shape
        
        # Convert labels to -1 and 1
        y_encoded = np.where(y == np.unique(y)[0], -1, 1)
        
        # Initialize weights
        self.weights = np.zeros(n_features)
        self.bias = 0
        
        # Gradient descent
        for _ in range(self.n_iterations):
            for idx, x_i in enumerate(X):
                condition = y_encoded[idx] * (np.dot(x_i, self.weights) + self.bias) >= 1
                
                if condition:
                    # Only regularization gradient
                    self.weights -= self.lr * (2 * self.lambda_param * self.weights)
                else:
                    # Full gradient
                    self.weights -= self.lr * (
                        2 * self.lambda_param * self.weights - 
                        np.dot(x_i, y_encoded[idx])
                    )
                    self.bias -= self.lr * (-y_encoded[idx])
        
        self.classes = np.unique(y)
        return self
    
    def predict(self, X):
        """Predict class labels."""
        linear_output = np.dot(X, self.weights) + self.bias
        predictions = np.sign(linear_output)
        
        # Map back to original labels
        return np.where(predictions <= 0, self.classes[0], self.classes[1])
    
    def decision_function(self, X):
        """Get decision scores."""
        return np.dot(X, self.weights) + self.bias


